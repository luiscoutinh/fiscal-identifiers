{
    "name": "luiscoutinh/fiscal-identifiers",
    "description": "Framework-agnostic PHP core for fiscal identifier validation and normalization (early development).",
    "type": "library",
    "license": "MIT",
    "keywords": ["fiscal-identifiers", "tax", "tin", "vat", "validation"],
    "homepage": "https://github.com/luiscoutinh/fiscal-identifiers",
    "support": {
        "issues": "https://github.com/luiscoutinh/fiscal-identifiers/issues",
        "source": "https://github.com/luiscoutinh/fiscal-identifiers"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.90",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {"FiscalIdentifiers\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"FiscalIdentifiers\\Tests\\": "tests/"}
    },
    "config": {
        "allow-plugins": {"pestphp/pest-plugin": true},
        "sort-packages": true
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage --min=100 --coverage-clover=build/coverage/clover.xml --coverage-html=build/coverage/html",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "format": "php-cs-fixer fix",
        "check": ["@composer validate --strict", "@test", "@analyse", "@lint"]
    }
}
